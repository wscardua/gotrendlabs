DJANGO_DEBUG=0
GOTRENDLABS_ENV=production
DJANGO_SECRET_KEY=change-me
DJANGO_SECURE_SSL_REDIRECT=1
DJANGO_SESSION_COOKIE_SECURE=1
DJANGO_CSRF_COOKIE_SECURE=1
GOTRENDLABS_RATE_LIMITS_ENABLED=1

GOTRENDLABS_DOMAIN=gotrendlabs.com.br,www.gotrendlabs.com.br,gotrendlabs.com,www.gotrendlabs.com
GOTRENDLABS_ALLOWED_HOSTS=gotrendlabs.com.br,www.gotrendlabs.com.br,gotrendlabs.com,www.gotrendlabs.com
GOTRENDLABS_CSRF_TRUSTED_ORIGINS=https://gotrendlabs.com.br,https://www.gotrendlabs.com.br,https://gotrendlabs.com,https://www.gotrendlabs.com
GOTRENDLABS_PUBLIC_BASE_URL=https://gotrendlabs.com.br
GOTRENDLABS_RUNTIME_CONFIG_PATH=/app/.runtime/platform_config.json
GOTRENDLABS_GEOLITE_CITY_PATH=/app/.runtime/geolite/GeoLite2-City.mmdb
GOTRENDLABS_ANALYTICS_PROXY_SECRET=change-me-shared-only-by-django-and-fastapi
GOTRENDLABS_ANALYTICS_TRUSTED_PROXY_CIDRS=
GOTRENDLABS_ANALYTICS_RETENTION_DAYS=90

BACKEND_API_URL=http://fastapi:8001
SYSTEM_LOG_RETENTION_DAYS=90

DJANGO_POSTGRES_DB=gotrendlabs
DJANGO_POSTGRES_USER=gotrendlabs_django
DJANGO_POSTGRES_PASSWORD=change-me
DJANGO_POSTGRES_HOST=gotrendlabs-prod-db.cinqq6ymy9in.us-east-1.rds.amazonaws.com
DJANGO_POSTGRES_PORT=5432

RECAPTCHA_ENABLED=0
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
GOTRENDLABS_SMTP_PASSWORD=
GOTRENDLABS_SMTP_API_KEY=
GOTRENDLABS_RESEND_API_KEY=
GOTRENDLABS_GOOGLE_CLIENT_ID=
GOTRENDLABS_GOOGLE_CLIENT_SECRET=
GOTRENDLABS_FACEBOOK_CLIENT_ID=
GOTRENDLABS_FACEBOOK_CLIENT_SECRET=
GOTRENDLABS_X_CONSUMER_KEY=
GOTRENDLABS_X_CONSUMER_SECRET=
GOTRENDLABS_X_CLIENT_ID=
GOTRENDLABS_X_CLIENT_SECRET=
GOTRENDLABS_PUSH_ENABLED=0
GOTRENDLABS_PUSH_PROVIDER=none
GOTRENDLABS_PUSH_DRY_RUN=1
GOTRENDLABS_FCM_CREDENTIALS_JSON=
OPENAI_API_KEY=
AWS_BEARER_TOKEN_BEDROCK=
GOTRENDLABS_INTEGRITY_KMS_KEY_ID=alias/gotrendlabs-integrity-signing
GOTRENDLABS_USER_COMMITMENT_SECRET=change-me-with-secret-manager
AWS_DEFAULT_REGION=us-east-1

# Administrative thumbnails: shared policy only, no provider credential here.
GTL_THUMB_ENABLED=0
GTL_THUMB_LEASE_SECONDS=300
GTL_THUMB_CLEANUP_SECONDS=300

# Market-thumbnail semantic planner (API freezes these settings per request).
# Independent of comment agents; no credentials here. Set on API and worker environment.
GTL_THUMB_PLANNER_MODEL=openai.gpt-oss-20b
GTL_THUMB_PLANNER_REGION=us-east-1
GTL_THUMB_PLANNER_TIMEOUT_SECONDS=45
GTL_THUMB_PLANNER_MAX_OUTPUT_TOKENS=2048
