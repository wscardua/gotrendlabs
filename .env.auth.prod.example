# FastAPI-only environment file; provision outside Git as .env.auth.prod.
GOTRENDLABS_PASSWORD_PEPPER=replace-with-base64-of-32-random-bytes
# Fernet key, generated once with cryptography. Losing it makes existing TOTP
# factors unreadable; keep its recoverable copy only in the secret manager.
GOTRENDLABS_TOTP_ENCRYPTION_KEY=replace-with-fernet-key
