# Copy to .env.api.local for local FastAPI only.
# Generate with: python -c 'import base64,secrets; print(base64.b64encode(secrets.token_bytes(32)).decode())'
GOTRENDLABS_PASSWORD_PEPPER=
# Generate with: python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
GOTRENDLABS_TOTP_ENCRYPTION_KEY=
FASTAPI_POSTGRES_DB=gotrendlabs
FASTAPI_POSTGRES_USER=gotrendlabs_fastapi
FASTAPI_POSTGRES_PASSWORD=change-me
FASTAPI_POSTGRES_HOST=127.0.0.1
FASTAPI_POSTGRES_PORT=5432
